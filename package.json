{
  "private": true,
  "main": "main/index.js",
  "productName": "ElectronTypescriptNext",
  "scripts": {
    "clean": "rimraf dist main renderer/out renderer/.next",
    "dev": "npm run build-electron && electron .",
    "build-renderer": "next build renderer",
    "build-electron": "tsc -p electron-src",
    "build": "npm run build-renderer && npm run build-electron",
    "lint": "npx eslint .",
    "prettier:check": "prettier renderer --check \"renderer/**/*.{js,jsx,ts,tsx,css}\"",
    "prettier:format": "prettier --write \"renderer/**/*.{js,jsx,ts,tsx,css}\"",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json"
  },
  "dependencies": {
    "autoprefixer": "10.7.0",
    "electron-is-dev": "3.0.1",
    "electron-next": "3.1.5",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "next": "16.4.6",
    "prettier": "^3.2.5",
    "rimraf": "6.1.4",
    "typescript": "5.9.3"
  },
  "build": {
    "asar": true,
    "files": [
      "main",
      "renderer/out"
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
